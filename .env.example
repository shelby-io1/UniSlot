# UniSlot environment configuration
#
# Copy to `.env.local` for local development and set the same variables in the
# Vercel project for production. Nothing here is required to run the app in
# demo mode — see DATABASE_URL below.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Neon serverless Postgres connection string (Vercel -> Storage -> Neon).
# When set, the app uses postgres.js and persists data in Neon.
# When UNSET, the app falls back to an in-memory PGlite (WASM Postgres)
# instance that is migrated and seeded on first request. No local database
# install is required, and nothing is written to disk.
#
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional: persist the local PGlite instance to a directory instead of
# keeping it in memory (useful for experiments). Leave unset in CI/production.
#
# PGLITE_DATA_DIR=.pglite

# ---------------------------------------------------------------------------
# Admin API
# ---------------------------------------------------------------------------
# Shared secret required on every admin mutation
# (POST/PATCH/DELETE /api/admin/**). Send it as the `x-admin-token` header or as
# `Authorization: Bearer <token>`. When this is unset, admin writes return 503.
# Generate a long random value, e.g. `openssl rand -hex 32`.
#
# ADMIN_TOKEN=change-me-to-a-long-random-string
